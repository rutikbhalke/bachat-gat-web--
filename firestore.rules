rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && (currentUser().role == 'admin' || currentUser().role_name == 'ADMIN');
    }

    function managesMoney() {
      return isAdmin() || (signedIn() && (currentUser().role == 'treasurer' || currentUser().role_name == 'TREASURER'));
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'member'
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.role_name == resource.data.role_name
      );
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /monthlyContributions/{contributionId} {
      allow read: if signedIn();
      allow write: if managesMoney();
    }

    match /loans/{loanId} {
      allow read: if signedIn();
      allow write: if managesMoney();
    }

    match /repayments/{repaymentId} {
      allow read: if signedIn();
      allow write: if managesMoney();
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create: if isAdmin() || managesMoney();
      allow update, delete: if isAdmin();
    }
  }
}
